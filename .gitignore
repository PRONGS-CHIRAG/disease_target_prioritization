# ---------------------------------------------------------------------------
# Data — raw data is immutable and re-downloadable; never commit it.
# Manifests ARE committed: they are the provenance record (Context.md §33).
# ---------------------------------------------------------------------------
data/**
!data/**/
!data/**/.gitkeep
!data/**/*.manifest.json
!data/raw/_manifest.jsonl

# Models & reports (artifacts, not source)
models/trained/**
!models/trained/.gitkeep
models/metadata/**
!models/metadata/.gitkeep
reports/figures/**
!reports/figures/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/

# Experiment tracking
mlruns/
wandb/
.optuna/

# Secrets & local config
.env
.env.local
*.local.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
