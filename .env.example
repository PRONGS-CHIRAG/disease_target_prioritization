# Copy to .env and adjust. Every value here is optional — the defaults work.
# Loaded by target_prioritization.config.Settings (env prefix: DTP_).

# Override the data root (default: <repo>/data). Useful if datasets live on an
# external drive — the core Open Targets pull is ~2.5 GB.
# DTP_DATA_DIR=/Volumes/external/dtp-data

# Logging: DEBUG | INFO | WARNING | ERROR
DTP_LOG_LEVEL=INFO

# Emit logs as JSON instead of human-readable console output.
DTP_LOG_JSON=false

# Concurrent download workers. Be considerate of public data providers
# (Context.md §34: "Respect database rate limits").
DTP_DOWNLOAD_CONCURRENCY=4

# Open Targets GraphQL endpoint — used for disease search/autocomplete in the
# app only. Bulk evidence always comes from the pinned FTP release so results
# stay reproducible.
DTP_OPEN_TARGETS_API=https://api.platform.opentargets.org/api/v4/graphql

# Pin the Open Targets release. Changing this invalidates every derived table;
# the release tag is recorded in each manifest (Context.md §32.7).
DTP_OPEN_TARGETS_RELEASE=26.06
